{
  "compilerOptions": {
    /* Project structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Module & target */
    "module": "commonjs",
    "target": "es2016",

    /* Interop */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Strictness */
    "strict": true,
    "skipLibCheck": true,

    /* JSON support (important for your config/database.json) */
    "resolveJsonModule": true,

    /* Source maps (optional but good for debugging) */
    "sourceMap": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}